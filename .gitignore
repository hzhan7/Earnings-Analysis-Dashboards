__pycache__/
*.py[cod]
.DS_Store
tmp/

# Source material is never published, whatever directory it lands in.
# README and index.html both promise this; these lines are what enforce it.
*.pdf
*.ppt
*.pptx
*.doc
*.docx
*.csv
*.xlsx
.env
.env.*

# Only reviewed company series are published.
# Adding a company? Add `!series/<slug>.json` below, or `git add -A` will skip
# the new series file silently (rc=0, absent from `git diff --cached`).
series/*.json
!series/amzn.json
!series/avgo.json
!series/axp.json
!series/cboe.json
!series/cdns.json
!series/cost.json
!series/googl.json
!series/ibkr.json
!series/ma.json
!series/mco.json
!series/meta.json
!series/msci.json
!series/msft.json
!series/ndaq.json
!series/nke.json
!series/nvda.json
!series/pm.json
!series/race.json
!series/schw.json
!series/snps.json
!series/spgi.json
!series/tjx.json
!series/tsm.json
!series/v.json
config/
build/ingest_local.py

# Local research notes about the private workflow. This repo is public and
# GitHub Pages serves every tracked file, so design notes that describe the
# local Earnings Analysis vault stay out of the tree.
docs/

# `tests/render_check.js` renders every page under jsdom -- the only gate in the
# suite that looks at a chart instead of at a payload. jsdom is the repo's one
# third-party dependency and it stays out of the tree: `tests/package.json` and
# its lockfile are committed, the 39 installed packages are not. GitHub Pages
# serves every tracked file, so a vendored node_modules would be published.
#   npm --prefix tests install
node_modules/
